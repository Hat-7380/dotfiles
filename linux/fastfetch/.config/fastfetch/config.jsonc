{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/clawd.png",
    "type": "kitty",
    "height": 9,
    "padding": { "top": 2, "left": 2, "right": 3 }
  },
  "display": {
    "separator": " ➜  ",
    "color": { "separator": "38;2;115;121;148" }
  },
  "modules": [
    "break",
    "break",
    { "type": "os",       "key": "OS   ", "keyColor": "38;2;202;158;230" },
    { "type": "kernel",   "key": " ├  ", "keyColor": "38;2;202;158;230" },
    { "type": "packages", "key": " ├ 󰏖 ", "keyColor": "38;2;202;158;230", "format": "{rpm} (rpm), {flatpak-system} (flatpak)" },
    { "type": "shell",    "key": " └  ", "keyColor": "38;2;202;158;230" },
    "break",
    { "type": "de",           "key": "DE   ", "keyColor": "38;2;140;170;238" },
    { "type": "theme",        "key": " ├ 󰉼 ", "keyColor": "38;2;140;170;238" },
    { "type": "icons",        "key": " ├ 󰀻 ", "keyColor": "38;2;140;170;238" },
    { "type": "cursor",       "key": " ├  ", "keyColor": "38;2;140;170;238" },
    { "type": "terminal",     "key": " ├  ", "keyColor": "38;2;140;170;238" },
    { "type": "terminalfont", "key": " └  ", "keyColor": "38;2;140;170;238" },
    "break",
    { "type": "cpu",    "key": "PC   ", "keyColor": "38;2;217;119;87", "format": "{name} ({cores-logical})" },
    { "type": "gpu",    "key": " ├ 󰢮 ", "keyColor": "38;2;217;119;87", "format": "{name}" },
    { "type": "memory", "key": " ├  ", "keyColor": "38;2;217;119;87" },
    { "type": "disk",   "key": " └ 󰋊 ", "keyColor": "38;2;217;119;87", "folders": "/" },
    "break",
    { "type": "custom", "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m " },
    "break"
  ]
}
