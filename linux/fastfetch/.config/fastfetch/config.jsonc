{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/clawd.png",
    "type": "kitty",
    "height": 6,
    "padding": { "top": 0, "left": 1, "right": 2 }
  },
  "display": {
    "separator": " › ",
    "color": { "separator": "38;2;115;121;148" }
  },
  "modules": [
    "break",
    { "type": "os",     "key": "OS  ", "keyColor": "38;2;231;130;132" },
    { "type": "kernel", "key": "KER ", "keyColor": "38;2;239;159;118" },
    { "type": "shell",  "key": "SH  ", "keyColor": "38;2;229;200;144" },
    { "type": "de",     "key": "DE  ", "keyColor": "38;2;166;209;137" },
    { "type": "memory", "key": "MEM ", "keyColor": "38;2;140;170;238" },
    { "type": "uptime", "key": "UP  ", "keyColor": "38;2;202;158;230" },
    "break"
  ]
}
