{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/clawd.txt",
    "padding": { "top": 2, "left": 2, "right": 3 }
  },
  "display": {
    "separator": " › ",
    "key": { "width": 7 },
    "color": { "separator": "38;2;131;139;167", "output": "38;2;198;208;245" },
    "percent": { "color": { "green": "38;2;166;209;137", "yellow": "38;2;229;200;144", "red": "38;2;231;130;132" } }
  },
  "modules": [
    "break",
    { "type": "os", "key": "{icon} OS", "keyColor": "38;2;244;184;228", "outputColor": "38;2;198;208;245" },
    { "type": "kernel", "key": "{icon} KER", "keyColor": "38;2;202;158;230", "outputColor": "38;2;198;208;245" },
    { "type": "shell", "key": "{icon} SH", "keyColor": "38;2;140;170;238", "outputColor": "38;2;198;208;245" },
    { "type": "memory", "key": "{icon} MEM", "keyColor": "38;2;133;193;220", "outputColor": "38;2;198;208;245" },
    { "type": "command", "key": "{icon} CLD", "keyColor": "38;2;129;200;190", "outputColor": "38;2;198;208;245", "text": "claude-usage" },
    "break"
  ]
}
