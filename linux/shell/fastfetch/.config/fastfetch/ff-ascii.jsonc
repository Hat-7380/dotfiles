{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "ASCIIFILE",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": " › ",
    "key": { "width": 7 },
    "color": { "separator": "38;2;131;139;167", "output": "38;2;198;208;245" },
    "percent": { "color": { "green": "38;2;166;209;137", "yellow": "38;2;229;200;144", "red": "38;2;231;130;132" } }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "38;2;244;184;228", "at": "38;2;131;139;167", "host": "38;2;140;170;238" } },
    "break",
    { "type": "os", "key": "{icon} OS", "keyColor": "38;2;244;184;228", "outputColor": "38;2;198;208;245" },
    { "type": "kernel", "key": "{icon} KER", "keyColor": "38;2;220;169;229", "outputColor": "38;2;198;208;245" },
    { "type": "packages", "key": "{icon} PKG", "keyColor": "38;2;193;160;231", "outputColor": "38;2;198;208;245" },
    { "type": "shell", "key": "{icon} SH", "keyColor": "38;2;158;167;236", "outputColor": "38;2;198;208;245" },
    { "type": "terminal", "key": "{icon} TER", "keyColor": "38;2;138;177;233", "outputColor": "38;2;198;208;245" },
    { "type": "de", "key": "{icon} DE", "keyColor": "38;2;134;190;223", "outputColor": "38;2;198;208;245" },
    { "type": "uptime", "key": "{icon} UP", "keyColor": "38;2;131;196;207", "outputColor": "38;2;198;208;245" },
    { "type": "memory", "key": "{icon} MEM", "keyColor": "38;2;129;200;190", "outputColor": "38;2;198;208;245" },
    "break",
    { "type": "custom", "format": "{#38;2;242;213;207}●{#} {#38;2;238;190;190}●{#} {#38;2;244;184;228}●{#} {#38;2;202;158;230}●{#} {#38;2;231;130;132}●{#} {#38;2;239;159;118}●{#} {#38;2;229;200;144}●{#} {#38;2;166;209;137}●{#} {#38;2;129;200;190}●{#} {#38;2;153;209;219}●{#} {#38;2;140;170;238}●{#} {#38;2;186;187;241}●{#}" }
  ]
}
